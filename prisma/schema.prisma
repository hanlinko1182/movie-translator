generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum MovieStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum GlossaryCategory {
  CHARACTER
  PLACE
  TITLE
  ORGANIZATION
  TERM
  PHRASE
  OTHER
}

enum TranslationOrigin {
  UNKNOWN
  MODEL
  TRANSLATION_MEMORY
  REFINED
  MANUAL
}

enum TranslationReviewStatus {
  UNREVIEWED
  NEEDS_REVIEW
  APPROVED
}

enum TranslationMemoryOrigin {
  MANUAL
  AUTOMATIC
}

enum SceneDetectionMethod {
  VISUAL_TRANSCRIPT_HEURISTIC
}

enum CharacterEvidenceType {
  MENTION
  SELF_IDENTIFICATION
  BEHAVIOR
  SPEECH_STYLE
  ACTION_INFERENCE
  RELATIONSHIP_CLUE
}

enum InferenceConfidence {
  LOW
  MEDIUM
  HIGH
}

enum CharacterRelationshipType {
  FAMILY
  FRIEND
  ALLY
  RIVAL
  ROMANTIC
  PROFESSIONAL
  UNKNOWN
  OTHER
}

enum TranslationQcCategory {
  EMPTY_OUTPUT
  EXCESSIVE_LENGTH
  POSSIBLE_OMISSION
  NUMBER_MISMATCH
  MARKDOWN_OR_COMMENTARY
  GLOSSARY_MISMATCH
  SUSPICIOUS_REPETITION
  SOURCE_TARGET_MISMATCH
  AMBIGUOUS_OR_WORDPLAY
}

enum TranslationQcSeverity {
  INFO
  WARNING
  ERROR
}

enum TranslationQcSource {
  HEURISTIC
  MODEL
  MANUAL
}

model Project {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  sourceLanguage String        @default("zh")
  targetLanguage String        @default("my")
  status         ProjectStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  movies         Movie[]
  glossaryEntries GlossaryEntry[]
  translationMemoryEntries TranslationMemoryEntry[]
  characters Character[]
  characterRelationships CharacterRelationship[]
}

model Movie {
  id                 String      @id @default(cuid())
  projectId          String
  title              String
  originalTitle      String?
  filename           String?
  storageKey         String?
  durationSeconds    Int?
  fileSizeBytes      BigInt?
  sourceLanguage     String      @default("zh")
  status             MovieStatus @default(UPLOADED)
  processingProgress Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  project            Project     @relation(fields: [projectId], references: [id])
  transcript         Transcript?
  translation        Translation?
  scenes             Scene[]
  characterAnalysis  CharacterAnalysisRun?
  characterEvidence  CharacterEvidence[]
  relationshipEvidence CharacterRelationshipEvidence[]

  @@index([projectId])
}

model Scene {
  id              String               @id @default(cuid())
  movieId         String
  sequence        Int
  startMs         Int
  endMs           Int
  detectionMethod SceneDetectionMethod @default(VISUAL_TRANSCRIPT_HEURISTIC)
  boundaryScore   Float?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  movie           Movie                @relation(fields: [movieId], references: [id], onDelete: Cascade)
  characterEvidence CharacterEvidence[]
  relationshipEvidence CharacterRelationshipEvidence[]

  @@unique([movieId, sequence])
  @@index([movieId, startMs, endMs])
}

model Transcript {
  id         String              @id @default(cuid())
  movieId    String              @unique
  provider   String
  model      String
  language   String?
  durationMs Int?
  text       String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  movie      Movie               @relation(fields: [movieId], references: [id], onDelete: Cascade)
  segments   TranscriptSegment[]
  translations Translation[]
  characterAnalyses CharacterAnalysisRun[]
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  sequence     Int
  startMs      Int
  endMs        Int
  text         String
  confidence   Float?
  createdAt    DateTime   @default(now())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  characterEvidence CharacterEvidence[]
  relationshipEvidence CharacterRelationshipEvidence[]

  @@unique([transcriptId, sequence])
}

model Translation {
  id                 String              @id @default(cuid())
  movieId            String              @unique
  sourceTranscriptId String
  provider           String
  model              String
  sourceLanguage     String
  targetLanguage     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  revision           Int                 @default(0)
  qcScannedAt        DateTime?
  movie              Movie               @relation(fields: [movieId], references: [id], onDelete: Cascade)
  sourceTranscript   Transcript          @relation(fields: [sourceTranscriptId], references: [id], onDelete: Cascade)
  segments           TranslatedSegment[]

  @@index([sourceTranscriptId])
}

model TranslatedSegment {
  id            String      @id @default(cuid())
  translationId String
  sequence      Int
  startMs       Int
  endMs         Int
  text          String
  provider      String?
  model         String?
  origin        TranslationOrigin @default(UNKNOWN)
  refinementJobId String?
  reviewStatus  TranslationReviewStatus @default(UNREVIEWED)
  revision      Int         @default(0)
  editedAt      DateTime?
  reviewedAt    DateTime?
  manualSourceHash String?  @db.VarChar(64)
  createdAt     DateTime    @default(now())
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  qcIssues      TranslationQcIssue[]

  @@unique([translationId, sequence])
}

model GlossaryEntry {
  id             String           @id @default(cuid())
  projectId      String
  sourceText     String
  targetText     String
  sourceLanguage String
  targetLanguage String
  category       GlossaryCategory @default(TERM)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceText, sourceLanguage, targetLanguage])
}

model TranslationMemoryEntry {
  id             String   @id @default(cuid())
  projectId      String
  sourceText     String
  targetText     String
  sourceLanguage String
  targetLanguage String
  sourceHash     String   @db.VarChar(64)
  origin         TranslationMemoryOrigin @default(MANUAL)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceLanguage, targetLanguage, sourceHash])
}

model TranslationQcIssue {
  id                  String @id @default(cuid())
  translatedSegmentId String
  category            TranslationQcCategory
  severity            TranslationQcSeverity
  message             String
  source              TranslationQcSource @default(HEURISTIC)
  resolvedAt          DateTime?
  resolution          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  translatedSegment   TranslatedSegment @relation(fields: [translatedSegmentId], references: [id], onDelete: Cascade)

  @@index([translatedSegmentId, resolvedAt])
}

model Character {
  id             String @id @default(cuid())
  projectId      String
  identityKey    String @db.VarChar(64)
  canonicalName  String
  normalizedName String
  uncertain      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aliases        CharacterAlias[]
  evidence       CharacterEvidence[]
  relationshipsA CharacterRelationship[] @relation("CharacterA")
  relationshipsB CharacterRelationship[] @relation("CharacterB")

  @@unique([projectId, identityKey])
  @@index([projectId, normalizedName])
}

model CharacterAlias {
  id              String @id @default(cuid())
  characterId     String
  alias           String
  normalizedAlias String
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([characterId, normalizedAlias])
}

model CharacterAnalysisRun {
  id           String @id @default(cuid())
  movieId      String @unique
  transcriptId String
  sourceHash   String @db.VarChar(64)
  provider     String
  model        String
  sceneCount   Int
  runtimeMs    Int
  modelCalls   Int
  usage        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  movie        Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  evidence     CharacterEvidence[]
  relationshipEvidence CharacterRelationshipEvidence[]
  @@index([transcriptId])
}

model CharacterEvidence {
  id                  String @id @default(cuid())
  analysisRunId       String
  characterId         String
  movieId             String
  sceneId             String?
  sceneSequence       Int
  transcriptSegmentId String
  evidenceKey         String @db.VarChar(64)
  evidenceType        CharacterEvidenceType
  evidenceText        String
  inference           String
  confidence          InferenceConfidence
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  analysisRun         CharacterAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  movie               Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  scene               Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  transcriptSegment   TranscriptSegment @relation(fields: [transcriptSegmentId], references: [id], onDelete: Cascade)
  @@unique([analysisRunId, evidenceKey])
  @@index([characterId, movieId])
  @@index([sceneId])
  @@index([transcriptSegmentId])
}

model CharacterRelationship {
  id               String @id @default(cuid())
  projectId        String
  characterAId     String
  characterBId     String
  relationshipType CharacterRelationshipType
  summary          String
  confidence       InferenceConfidence
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterA       Character @relation("CharacterA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterB       Character @relation("CharacterB", fields: [characterBId], references: [id], onDelete: Cascade)
  evidence         CharacterRelationshipEvidence[]
  @@unique([projectId, characterAId, characterBId])
  @@index([characterAId])
  @@index([characterBId])
}

model CharacterRelationshipEvidence {
  id                  String @id @default(cuid())
  analysisRunId       String
  relationshipId     String
  movieId             String
  sceneId             String?
  sceneSequence       Int
  transcriptSegmentId String
  evidenceKey         String @db.VarChar(64)
  relationshipType    CharacterRelationshipType
  relationshipSummary String
  evidenceText        String
  inference           String
  confidence          InferenceConfidence
  createdAt           DateTime @default(now())
  analysisRun         CharacterAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  relationship        CharacterRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  movie               Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  scene               Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  transcriptSegment   TranscriptSegment @relation(fields: [transcriptSegmentId], references: [id], onDelete: Cascade)
  @@unique([analysisRunId, evidenceKey])
  @@index([relationshipId, movieId])
  @@index([sceneId])
  @@index([transcriptSegmentId])
}
