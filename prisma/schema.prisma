generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum MovieStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum GlossaryCategory {
  CHARACTER
  PLACE
  TITLE
  ORGANIZATION
  TERM
  PHRASE
  OTHER
}

enum TranslationOrigin {
  UNKNOWN
  MODEL
  TRANSLATION_MEMORY
  REFINED
}

enum TranslationMemoryOrigin {
  MANUAL
  AUTOMATIC
}

enum TranslationQcCategory {
  EMPTY_OUTPUT
  EXCESSIVE_LENGTH
  POSSIBLE_OMISSION
  NUMBER_MISMATCH
  MARKDOWN_OR_COMMENTARY
  GLOSSARY_MISMATCH
  SUSPICIOUS_REPETITION
  SOURCE_TARGET_MISMATCH
  AMBIGUOUS_OR_WORDPLAY
}

enum TranslationQcSeverity {
  INFO
  WARNING
  ERROR
}

enum TranslationQcSource {
  HEURISTIC
  MODEL
  MANUAL
}

model Project {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  sourceLanguage String        @default("zh")
  targetLanguage String        @default("my")
  status         ProjectStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  movies         Movie[]
  glossaryEntries GlossaryEntry[]
  translationMemoryEntries TranslationMemoryEntry[]
}

model Movie {
  id                 String      @id @default(cuid())
  projectId          String
  title              String
  originalTitle      String?
  filename           String?
  storageKey         String?
  durationSeconds    Int?
  fileSizeBytes      BigInt?
  sourceLanguage     String      @default("zh")
  status             MovieStatus @default(UPLOADED)
  processingProgress Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  project            Project     @relation(fields: [projectId], references: [id])
  transcript         Transcript?
  translation        Translation?

  @@index([projectId])
}

model Transcript {
  id         String              @id @default(cuid())
  movieId    String              @unique
  provider   String
  model      String
  language   String?
  durationMs Int?
  text       String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  movie      Movie               @relation(fields: [movieId], references: [id], onDelete: Cascade)
  segments   TranscriptSegment[]
  translations Translation[]
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  sequence     Int
  startMs      Int
  endMs        Int
  text         String
  confidence   Float?
  createdAt    DateTime   @default(now())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, sequence])
}

model Translation {
  id                 String              @id @default(cuid())
  movieId            String              @unique
  sourceTranscriptId String
  provider           String
  model              String
  sourceLanguage     String
  targetLanguage     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  revision           Int                 @default(0)
  qcScannedAt        DateTime?
  movie              Movie               @relation(fields: [movieId], references: [id], onDelete: Cascade)
  sourceTranscript   Transcript          @relation(fields: [sourceTranscriptId], references: [id], onDelete: Cascade)
  segments           TranslatedSegment[]

  @@index([sourceTranscriptId])
}

model TranslatedSegment {
  id            String      @id @default(cuid())
  translationId String
  sequence      Int
  startMs       Int
  endMs         Int
  text          String
  provider      String?
  model         String?
  origin        TranslationOrigin @default(UNKNOWN)
  refinementJobId String?
  createdAt     DateTime    @default(now())
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  qcIssues      TranslationQcIssue[]

  @@unique([translationId, sequence])
}

model GlossaryEntry {
  id             String           @id @default(cuid())
  projectId      String
  sourceText     String
  targetText     String
  sourceLanguage String
  targetLanguage String
  category       GlossaryCategory @default(TERM)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceText, sourceLanguage, targetLanguage])
}

model TranslationMemoryEntry {
  id             String   @id @default(cuid())
  projectId      String
  sourceText     String
  targetText     String
  sourceLanguage String
  targetLanguage String
  sourceHash     String   @db.VarChar(64)
  origin         TranslationMemoryOrigin @default(MANUAL)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceLanguage, targetLanguage, sourceHash])
}

model TranslationQcIssue {
  id                  String @id @default(cuid())
  translatedSegmentId String
  category            TranslationQcCategory
  severity            TranslationQcSeverity
  message             String
  source              TranslationQcSource @default(HEURISTIC)
  resolvedAt          DateTime?
  resolution          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  translatedSegment   TranslatedSegment @relation(fields: [translatedSegmentId], references: [id], onDelete: Cascade)

  @@index([translatedSegmentId, resolvedAt])
}
