# Database / Redis — inject real values at runtime, never commit them
DATABASE_URL=
REDIS_URL=

# Storage — development defaults work without renaming current variables.
# Production requires an explicit absolute root on a persistent private volume.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=storage

# OpenRouter — required only for AI workers/actions, not web/media/scene startup
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models — production processes require their own model; no silent default
TRANSCRIPTION_MODEL=qwen/qwen3-asr-1.7b
# Optional benchmark-only pair
TRANSLATION_MODEL_PRIMARY=
TRANSLATION_MODEL_COMPARE=
# Recommended: openai/gpt-6-luna
TRANSLATION_MODEL=
# Recommended: openai/gpt-6-sol
TRANSLATION_REFINEMENT_MODEL=
# Recommended: openai/gpt-6-luna
CHARACTER_ANALYSIS_MODEL=
RECAP_MODEL=

# Scene detection — conservative defaults retained
SCENE_CHANGE_THRESHOLD=0.4
SCENE_MIN_DURATION_MS=15000
SCENE_TRANSCRIPT_GAP_MS=8000

# Runtime — supervisor stop grace must exceed this drain deadline
WORKER_SHUTDOWN_TIMEOUT_MS=120000
